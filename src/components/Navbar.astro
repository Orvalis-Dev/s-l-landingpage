<header class="site-header" id="inicio">
  <div class="container nav-wrap">
    <a href="#inicio" class="brand" aria-label="Ir al inicio">S&L Servicios Industriales</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Abrir menú</span>
      ☰
    </button>

    <nav class="desktop-nav" aria-label="Principal">
      <a href="#servicios">Servicios</a>
      <a href="#productos">Productos</a>
      <a href="#catalogo">Catálogo</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Menú móvil" hidden>
    <button class="menu-close" type="button" aria-label="Cerrar menú">✕</button>
    <a href="#servicios">Servicios</a>
    <a href="#productos">Productos</a>
    <a href="#catalogo">Catálogo</a>
    <a href="#contacto">Contacto</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const close = document.querySelector('.menu-close');
  const menu = document.querySelector('#mobile-menu');
  const header = document.querySelector('.site-header');
  const desktopMedia = window.matchMedia('(min-width: 1024px)');
  const links = menu?.querySelectorAll('a') ?? [];

  const updateHeaderOnScroll = () => {
    if (window.scrollY > 14) {
      header?.classList.add('scrolled');
      return;
    }

    header?.classList.remove('scrolled');
  };

  const openMenu = () => {
    if (desktopMedia.matches) {
      return;
    }

    menu?.removeAttribute('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    header?.classList.add('menu-open');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    menu?.setAttribute('hidden', '');
    toggle?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('menu-open');
    document.body.style.overflow = '';
  };

  const syncMenuByViewport = () => {
    if (desktopMedia.matches) {
      closeMenu();
    }
  };

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  links.forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
  desktopMedia.addEventListener('change', syncMenuByViewport);
  updateHeaderOnScroll();
  syncMenuByViewport();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 20;
    border-bottom: 1px solid rgba(242, 183, 5, 0.18);
    background: transparent;
    backdrop-filter: blur(0);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  .site-header.scrolled {
    background-color: rgba(0, 0, 0, 0.85);
    border-bottom-color: rgba(68, 68, 68, 0.72);
    backdrop-filter: blur(8px);
  }

  .site-header.menu-open {
    background-color: rgba(10, 10, 10, 0.94);
    border-bottom-color: rgba(68, 68, 68, 0.8);
    backdrop-filter: blur(6px);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 1rem;
  }

  .brand {
    font-family: var(--font-subheading);
    font-weight: 700;
    font-size: 0.95rem;
    max-width: 13.5rem;
    line-height: 1.2;
  }

  .menu-toggle,
  .menu-close {
    border: 1px solid #3c3c3c;
    background: rgba(17, 17, 17, 0.5);
    color: var(--color-light);
    border-radius: 0.5rem;
    padding: 0.4rem 0.65rem;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .desktop-nav {
    display: none;
    gap: 1.5rem;
    font-family: var(--font-subheading);
    font-weight: 600;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.35);
  }

  .desktop-nav a:hover {
    color: var(--color-primary);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    background: #111111;
    font-family: var(--font-subheading);
    font-size: 1.6rem;
    animation: menu-enter 250ms ease-out;
  }

  .mobile-menu a {
    color: var(--color-light);
    transition: color 0.3s ease;
  }

  .mobile-menu a:hover {
    color: var(--color-primary);
  }

  .menu-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
  }

  @keyframes menu-enter {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .brand {
      font-size: 1rem;
      max-width: 16rem;
    }
  }

  @media (min-width: 1024px) {
    .menu-toggle,
    .mobile-menu {
      display: none;
    }

    .desktop-nav {
      display: flex;
    }

    .brand {
      font-size: 1.02rem;
      max-width: none;
    }
  }
</style>
